[sub_resource type="GDScript" id="GDScript_iit7f"]
script/source = "extends Node3D

@export var ReactorTemp: float
@export var ReactorChamberPressure: float
@export var Laser1Power: float = 25
@export var Laser2Power: float = 25
@export var Laser3Power: float = 25
@export var Laser1Pressure: float = 0
@export var Laser2Pressure: float = 0
@export var Laser3Pressure: float = 0
@export var Coolant1Power: float = 25
@export var Coolant2Power: float = 25
@export var Coolant3Power: float = 25
@export var CoolantStability: float = 100
@export var Camera: Camera3D
@export var MainControlRoomScreenViewport: SubViewport
@export var ReactorStarted: bool = false
@export var ReactorStarting: bool = false
@export var ReactorVisible: bool = false

@onready var Reactor = $Reactor
@onready var ReactorSound = $Reactor/Sound
@onready var Lasers = $Lasers
@onready var Laser1 = $Lasers/Laser1
@onready var Laser2 = $Lasers/Laser2
@onready var Laser3 = $Lasers/Laser3
@onready var CameraEnvironment: Environment = Camera.environment

var ButtonGroupName = \"Buttons\"
var ButtonDebounces = []
var activeOSTs = []

func quickCreateSound(parent: Node3D, resource: String, volumeDB: int):
	var sound := AudioStreamPlayer.new()
	sound.stream = load(resource)
	sound.volume_db = volumeDB
	parent.add_child(sound)
	sound.play()

func clearAllActiveOSTs():
	for activeOST in activeOSTs:
		activeOST.queue_free()
		activeOSTs.erase(activeOST)
		
func playOST(resource: String, volume: int):
	var sound := AudioStreamPlayer.new()
	sound.stream = load(resource)
	sound.volume_db = volume
	add_child(sound)
	sound.play()
	activeOSTs.append(sound)
	return sound

func button_startup():
	if ReactorStarting or ReactorStarted:
		return
	ReactorStarting = true
	clearAllActiveOSTs()
	var StartupOST = playOST(\"res://Content/startup.mp3\", -12)
	get_tree().create_timer(27 - 7).timeout.connect(func(): 
		for Laser in Lasers.get_children():
			for Holder in Laser.get_node(\"SteamParticles\").get_children():
				var CPUParticles = Holder.get_node(\"CPUParticles3D\")
				if CPUParticles:
					CPUParticles.emitting = true
	)
	await get_tree().create_timer(27).timeout
	quickCreateSound(Reactor, \"res://Content/exp2.mp3\", -6)
	quickCreateSound(Reactor, \"res://Content/rcamb.mp3\", -7)
	get_tree().create_timer(19.4 - 1.5).timeout.connect(func(): 
		for Laser in Lasers.get_children():
			var StartingParticles = Laser.get_node(\"StartingParticles\")
			if StartingParticles:
				var Particle = StartingParticles.get_node(\"Particle\")
				if Particle:
					Particle.emitting = true
	)
	await get_tree().create_timer(19.4).timeout
	quickCreateSound(Reactor, \"res://Content/exp1.mp3\", -2)
	quickCreateSound(Reactor, \"res://Content/exp3.mp3\", 0)
	get_tree().create_timer(20).timeout.connect(func(): get_tree().create_tween().tween_property(StartupOST, \"volume_db\", -120, 20))
	var NewTween = get_tree().create_tween()
	CameraEnvironment.tonemap_exposure = 500
	NewTween.tween_property(CameraEnvironment, \"tonemap_exposure\", 1, 5).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	ReactorTemp = 6000
	ReactorStarted = true
	ReactorStarting = false

func can_press_button(button: Node3D):
	if !button.is_in_group(ButtonGroupName):
		return false
	if ButtonDebounces.find(button) != -1:
		return false
	return true

func button_press_animation(button: Node3D):
	if !can_press_button(button):
		return false
	ButtonDebounces.append(button)
	var currentPosition = button.position
	var newPosition = currentPosition + Vector3(0, -0.025, 0)
	var tween = get_tree().create_tween()
	var sound := AudioStreamPlayer.new()
	sound.stream = preload(\"res://Content/btn.mp3\")
	button.add_child(sound)
	sound.play()
	tween.tween_property(button, \"position\", newPosition, 0.03).set_trans(Tween.TRANS_EXPO).set_ease(Tween.EASE_OUT)
	tween.tween_property(button, \"position\", currentPosition, 0.4).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_IN_OUT)
	await tween.finished
	sound.queue_free()
	ButtonDebounces.erase(button)
	return true

func _input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed and event.button_index == 1:
		var from = Camera.project_ray_origin(event.position)
		var to = from + Camera.project_ray_normal(event.position) * 7
		var space_state = get_world_3d().direct_space_state
		var query = PhysicsRayQueryParameters3D.create(from, to)
		var result = space_state.intersect_ray(query)
		if result:
			var clicked_object = result.collider
			if clicked_object.is_in_group(ButtonGroupName):
				if can_press_button(clicked_object):
					var ParentObject = clicked_object.get_parent()
					if ParentObject.name == \"buttonTest\":
						call_deferred(&\"button_startup\")
					elif ParentObject.name == \"buttonTest2\":
						clearAllActiveOSTs()
						playOST(\"res://Content/troll.mp3\", -12)
				button_press_animation(clicked_object)
	pass

func _ready() -> void:
	if !CameraEnvironment:
		push_warning(\"Missing camera environment, this will lead to errors\")
	pass
	
func updateReactorVisibility():
	if ReactorVisible != ReactorStarted:
		ReactorVisible = ReactorStarted
		Reactor.visible = ReactorStarted
		Reactor.get_node(\"OmniLight3D\").visible = ReactorStarted
		Laser1.get_node(\"Shader\").visible = ReactorStarted
		Laser2.get_node(\"Shader\").visible = ReactorStarted
		Laser3.get_node(\"Shader\").visible = ReactorStarted

func updateViewportScreens():
	MainControlRoomScreenViewport.get_node(\"Control\").get_node(\"Label\").text = \"Temp: \" + str(ReactorTemp)

func _process(delta: float) -> void:
	if ReactorStarted:
		CoolantStability = clamp(CoolantStability - (((Coolant1Power + Coolant2Power + Coolant3Power) / 100) * delta), 0, 100)
		if Laser1Pressure <= 2500:
			ReactorTemp += ((Laser1Power / 25) + 2) * delta
			if Laser1Power > 20:
				Laser1Pressure += (clamp(abs(20 - Laser1Power) / 10, 0, 75) * 25) * delta
		if Laser2Pressure <= 2500:
			ReactorTemp += ((Laser2Power / 25) + 2) * delta
			if Laser2Power > 20:
				Laser2Pressure += (clamp(abs(20 - Laser2Power) / 10, 0, 75) * 25) * delta
		if Laser3Pressure <= 2500:
			ReactorTemp += ((Laser3Power / 25) + 2) * delta
			if Laser3Power > 20:
				Laser3Pressure += (clamp(abs(20 - Laser3Power) / 10, 0, 75) * 25) * delta
		ReactorTemp -= ((Coolant1Power + Coolant2Power + Coolant3Power) / 80) * delta
		Reactor.rotate(Vector3(0, 1, 0), deg_to_rad(clamp((ReactorTemp / 12000) * 30, 1, 30)));
	updateReactorVisibility()
	updateViewportScreens()
	pass
"

